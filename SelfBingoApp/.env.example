# Current Active Game Contract (auto-populated)
NEXT_PUBLIC_CURRENT_GAME_ADDRESS=

# Self Protocol Configuration
NEXT_PUBLIC_SELF_APP_NAME=Self Bingo
NEXT_PUBLIC_SELF_SCOPE=self-bingo
NEXT_PUBLIC_SELF_ENDPOINT=https://codalabs.ngrok.io # Your backend verification endpoint (ngrok for local dev)

# API Routes
