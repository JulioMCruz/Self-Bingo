NEXT_PUBLIC_IMAGE_URL=https://www.selfbingo.xyz/self-bingo-preview.png
NEXT_PUBLIC_SPLASH_IMAGE_URL=https://www.selfbingo.xyz/self-bingo-splash.png

# Chain Configuration - Celo Sepolia Testnet
NEXT_PUBLIC_CHAIN_ID=11142220 # Celo Sepolia Testnet (use 42220 for Mainnet, 44787 for Alfajores)

# Celo RPC URLs
NEXT_PUBLIC_RPC_URL=https://celo-sepolia.g.alchemy.com/v2/poBa7Z2kA8GF4mNoLdJqG
NEXT_PUBLIC_RPC_URL_CELO_MAINNET=https://celo-mainnet.g.alchemy.com/v2/poBa7Z2kA8GF4mNoLdJqG

# Game Configuration
NEXT_PUBLIC_ENTRY_FEE_CELO=0.05 # Entry fee in native CELO (18 decimals)
NEXT_PUBLIC_MIN_PLAYERS=2 # Minimum players to start game
NEXT_PUBLIC_MAX_PLAYERS=100 # Maximum players per game

# Contract Addresses (Celo Sepolia Testnet)
# Bingo Factory Contract (deployed)
